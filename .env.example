# Development example only. Replace every token before use.
SIH_AUTH_ENABLED=true
SIH_VIEWER_TOKEN=replace-with-random-viewer-token
SIH_OPERATOR_TOKEN=replace-with-random-operator-token
SIH_ADMIN_TOKEN=replace-with-random-admin-token
SIH_API_TOKEN=replace-with-the-dashboard-role-token

SIH_TELEMETRY_MODE=mock
SIH_TELEMETRY_INTERFACE=
SIH_TELEMETRY_STALE_AFTER_SECONDS=30
SIH_MAX_REQUEST_BYTES=2000000
SIH_LOG_LEVEL=INFO
DASHBOARD_PORT=8501
